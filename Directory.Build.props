<Project>

  <!-- Shared by the app and the test project. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the build warning-free: any compiler warning fails the build, locally and in CI. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability advisories stay warnings; the CI audit step fails on them instead,
         so a newly published advisory doesn't suddenly break local builds. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- The .NET code analyzers' recommended rule set (correctness, security, performance) plus the
         code style in .editorconfig, both checked in every build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for the unused-usings check (IDE0005) in the build; the XML docs themselves are optional. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Third-party analyzers on top of the .NET ones, also failing the build: Meziantou (correctness,
       async, string comparisons, collections) and SonarAnalyzer (bugs, code smells, security hotspots).
       Build-time only; they don't ship with the app. Rules that don't fit are switched off in .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.291" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>

</Project>
