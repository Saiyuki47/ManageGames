@{
    ViewData["Title"] = "Add Company";
}
<link rel="stylesheet" runat="server" media="screen" href="~/css/AddEditGames.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div>
    <form asp-controller=Home asp-action=AddCompany method="post">
        <fieldset>
            <legend>@ViewData["Title"]</legend>
            <div>
                <div>
                    <label class="textshit">Companyname:</label>
                    <input type=text name="companyName" required/>
                </div>

                <div class="editResetDiv">
                    <button type="submit">Save</button>
                </div>

            </div>

        </fieldset>
    </form>

</div>
