@{
    ViewData["Title"] = "Edit Category";
}
<link rel="stylesheet" runat="server" media="screen" href="~/css/AddEditGames.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

@model ManageGames.ViewModels.AddEditCategory;

<div>
    @*asp-action und controller reinpacken*@
    <form asp-controller=Home asp-action=SaveEditedCategory method="post">
        <fieldset>
            <legend>@ViewData["Title"]</legend>
            <div>

                <div>
                    <label>Consolename:</label>
                    <input type=text name="categoryName" value="@(Model.Console.ConsoleName)" required/>
                    <input type="hidden" name="category_id" value="@Model.Console.ConsoleId"/>
                </div>

                <div>
                    <label>Company:</label>
                    <select name="company">
                        <option value="" selected="@(Model.Console.CompanyId == null)">(none)</option>
                        @for (int i = 0; i < Model.CompanyList.Count; i++)
                        {
                            <option value="@Model.CompanyList[i].CompanyId"
                            selected="@(Model.CompanyList[i].CompanyId == Model.Console.CompanyId)">@Model.CompanyList[i].CompanyName</option>
                        }
                    </select>
                </div>

                <div class="editResetDiv">
                    <button type="submit">Save</button>
                </div>

            </div>

        </fieldset>
    </form>
    
</div>