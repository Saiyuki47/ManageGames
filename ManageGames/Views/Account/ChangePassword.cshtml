@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<form asp-action="ChangePassword" method="post" class="edit-form">
    <fieldset>
        <legend>@ViewData["Title"]</legend>
        @if (User.HasPendingPasswordChange())
        {
            <p class="form-hint">Please choose your own password before you continue.</p>
        }
        else
        {
            <p class="form-hint">This signs you out on all other devices.</p>
        }

        <div class="form-row">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" required autofocus />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>

        <div class="form-row">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" required />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="form-row">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit">Change password</button>
        </div>
    </fieldset>
</form>
