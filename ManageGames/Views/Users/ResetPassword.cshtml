@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<form asp-action="ResetPassword" method="post" class="edit-form">
    <fieldset>
        <legend>@ViewData["Title"] of @Model.Username</legend>
        <p class="form-hint">Signs the user out everywhere. They have to replace the temporary password at their next login.</p>

        <div class="form-row">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" required autofocus />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="form-actions">
            <a class="button-link" asp-action="Index">Cancel</a>
            <button type="submit">Reset</button>
        </div>
    </fieldset>
</form>
